{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunnerCapabilities",
  "type": "object",
  "required": [
    "protocol_version",
    "runner_id",
    "runner_version",
    "tasks"
  ],
  "properties": {
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DeviceCapability"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ModelCapability"
      }
    },
    "protocol_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "runner_id": {
      "type": "string"
    },
    "runner_version": {
      "type": "string"
    },
    "scales": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RunnerTask"
      }
    },
    "test_behaviors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FakeBehavior"
      }
    },
    "upstream": {
      "anyOf": [
        {
          "$ref": "#/definitions/UpstreamInfo"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DeviceCapability": {
      "type": "object",
      "required": [
        "backend",
        "index",
        "name"
      ],
      "properties": {
        "backend": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "FakeBehavior": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "malformed_ndjson",
        "crash",
        "hang",
        "completed_then_nonzero",
        "spawn_grandchild_and_hang"
      ]
    },
    "ModelCapability": {
      "type": "object",
      "required": [
        "id",
        "scales"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "scales": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          }
        }
      },
      "additionalProperties": false
    },
    "RunnerTask": {
      "type": "string",
      "enum": [
        "fake_validation",
        "image_upscale",
        "video_interpolate"
      ]
    },
    "UpstreamInfo": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "source_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
