{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoos-upscale.local/schemas/runner-protocol-v1/capabilities.schema.json",
  "title": "Zoos Upscale Runner Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "runner_id",
    "runner_version",
    "tasks",
    "test_behaviors"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "runner_id": { "type": "string", "minLength": 1 },
    "runner_version": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": "fake" }
    },
    "test_behaviors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "success",
          "failed",
          "malformed_ndjson",
          "crash",
          "hang",
          "completed_then_nonzero",
          "spawn_grandchild_and_hang"
        ]
      }
    }
  }
}
