{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunnerEvent",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "event",
        "stage"
      ],
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "started"
          ]
        },
        "stage": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "completed_units",
        "elapsed_ms",
        "event",
        "stage",
        "total_units",
        "unit"
      ],
      "properties": {
        "chunk_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_units": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "elapsed_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "estimated_remaining_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "event": {
          "type": "string",
          "enum": [
            "progress"
          ]
        },
        "rate": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "rate_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": "string"
        },
        "total_units": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "unit": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "code",
        "event",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "enum": [
            "warning"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "event",
        "output"
      ],
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "completed"
          ]
        },
        "output": {
          "$ref": "#/definitions/RunnerOutput"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "error_code",
        "event",
        "message"
      ],
      "properties": {
        "error_code": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "enum": [
            "failed"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  ],
  "required": [
    "event_version",
    "job_id",
    "protocol_version",
    "sequence"
  ],
  "properties": {
    "event_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "job_id": {
      "type": "string"
    },
    "protocol_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "sequence": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "RunnerOutput": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
