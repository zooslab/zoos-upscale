{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoos-upscale.local/schemas/runner-protocol-v1/event.schema.json",
  "title": "Zoos Upscale Runner Event",
  "oneOf": [
    {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["event", "stage"],
          "properties": {
            "event": { "const": "started" },
            "stage": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": [
            "event",
            "stage",
            "completed_units",
            "total_units",
            "unit",
            "elapsed_ms"
          ],
          "properties": {
            "event": { "const": "progress" },
            "stage": { "$ref": "#/$defs/nonEmptyString" },
            "completed_units": { "type": "integer", "minimum": 0 },
            "total_units": { "type": "integer", "minimum": 1 },
            "unit": { "$ref": "#/$defs/nonEmptyString" },
            "elapsed_ms": { "type": "integer", "minimum": 0 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["event", "code", "message"],
          "properties": {
            "event": { "const": "warning" },
            "code": { "$ref": "#/$defs/nonEmptyString" },
            "message": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["event", "output"],
          "properties": {
            "event": { "const": "completed" },
            "output": { "$ref": "#/$defs/pathObject" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["event", "error_code", "message"],
          "properties": {
            "event": { "const": "failed" },
            "error_code": { "$ref": "#/$defs/nonEmptyString" },
            "message": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "required": ["protocol_version", "event_version", "sequence", "job_id"],
      "properties": {
        "protocol_version": { "const": 1 },
        "event_version": { "const": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "job_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "pathObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
