{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FakeJobRequest",
  "type": "object",
  "required": [
    "input",
    "job_id",
    "output",
    "parameters",
    "protocol_version",
    "task",
    "test_behavior"
  ],
  "properties": {
    "input": {
      "$ref": "#/definitions/RunnerInput"
    },
    "job_id": {
      "type": "string"
    },
    "output": {
      "$ref": "#/definitions/RunnerOutput"
    },
    "parameters": {
      "$ref": "#/definitions/FakeParameters"
    },
    "protocol_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "task": {
      "$ref": "#/definitions/FakeTask"
    },
    "test_behavior": {
      "$ref": "#/definitions/FakeBehavior"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "FakeBehavior": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "malformed_ndjson",
        "crash",
        "hang",
        "completed_then_nonzero",
        "spawn_grandchild_and_hang"
      ]
    },
    "FakeParameters": {
      "type": "object",
      "required": [
        "step_delay_ms",
        "steps"
      ],
      "properties": {
        "step_delay_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "steps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "FakeTask": {
      "type": "string",
      "enum": [
        "fake"
      ]
    },
    "RunnerInput": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RunnerOutput": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
